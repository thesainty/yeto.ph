{
  "name": "yeto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "node tests/config.test.mjs && node tests/database.test.mjs && node tests/social-database.test.mjs && node tests/circles-database.test.mjs && node tests/inbox-database.test.mjs && node tests/polls-database.test.mjs && node tests/reminders-database.test.mjs && node --experimental-strip-types tests/calendar.test.mjs && node tests/conversations-database.test.mjs && node tests/direct-chats-database.test.mjs",
    "test:database": "node tests/database.test.mjs",
    "test:config": "node tests/config.test.mjs",
    "test:social": "node tests/social-database.test.mjs",
    "test:circles": "node tests/circles-database.test.mjs",
    "test:inbox": "node tests/inbox-database.test.mjs",
    "test:polls": "node tests/polls-database.test.mjs",
    "test:reminders": "node tests/reminders-database.test.mjs && node --experimental-strip-types tests/calendar.test.mjs",
    "test:conversations": "node tests/conversations-database.test.mjs",
    "test:chats": "node tests/direct-chats-database.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
